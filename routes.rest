### ===================================================
### VEHICLES ENDPOINTS
### ===================================================

### Get all vehicles
GET http://localhost:8080/vehicles

### Get one vehicle by valid ID
GET http://localhost:8080/vehicles/6aa9d14411e41d81e58a6649

### Get vehicle with INVALID ID format (Should return 400 Bad Request)
GET http://localhost:8080/vehicles/invalid-id-123

### Create vehicle (Valid)
POST http://localhost:8080/vehicles
Content-Type: application/json

{
    "dealershipId": "6aa9d34311e41d81e58a664b",
    "make": "Toyota",
    "model": "Tacoma",
    "year": 2022,
    "color": "Army Green",
    "mileage": 18500,
    "price": 34999,
    "vin": "1TGRX5EF2NC012345"
}

### Create vehicle with INVALID data (Should return 400 Bad Request)
POST http://localhost:8080/vehicles
Content-Type: application/json

{
    "dealershipId": "not-a-valid-id",
    "make": "",
    "model": "Tacoma",
    "year": "twenty-twenty",
    "color": "",
    "mileage": -500,
    "price": "free",
    "vin": "short-vin"
}

### Update vehicle (Valid)
PUT http://localhost:8080/vehicles/6aa9e82e57fc1e7aa644496a
Content-Type: application/json

{
    "dealershipId": "6aa9d34311e41d81e58a664b",
    "make": "Toyota",
    "model": "Tacoma TRD Pro",
    "year": 2022,
    "color": "Midnight Black",
    "mileage": 19200,
    "price": 36500,
    "vin": "1TGRX5EF2NC012345"
}

### Update vehicle with INVALID ID format (Should return 400 Bad Request)
PUT http://localhost:8080/vehicles/bad-id
Content-Type: application/json

{
    "dealershipId": "6aa9d34311e41d81e58a664b",
    "make": "Toyota",
    "model": "Tacoma",
    "year": 2022,
    "color": "Black",
    "mileage": 19200,
    "price": 36500,
    "vin": "1TGRX5EF2NC012345"
}

### Delete vehicle (Valid)
DELETE http://localhost:8080/vehicles/6aa9e82e57fc1e7aa644496a

### Delete vehicle with INVALID ID format (Should return 400 Bad Request)
DELETE http://localhost:8080/vehicles/bad-id


